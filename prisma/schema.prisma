generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  phone           String
  email           String
  package         String
  propertyType    String
  purpose         String?
  parcelInfo      String?
  listingUrl      String?
  notes           String?
  selectedOptions String?  // JSON string of selected package add-ons
  kvkkAccepted    Boolean  @default(false)
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model PageContent {
  id       String @id @default(cuid())
  pageSlug String
  key      String
  tr       String
  en       String

  @@unique([pageSlug, key])
}

model Faq {
  id         String   @id @default(cuid())
  questionTr String
  answerTr   String
  questionEn String
  answerEn   String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

