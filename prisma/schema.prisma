generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactSubmission {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  phone        String
  email        String
  package      String
  propertyType String
  purpose      String?
  parcelInfo   String?
  listingUrl   String?
  notes        String?
  isRead       Boolean  @default(false)
  kvkkAccepted Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model PageContent {
  id        String   @id @default(cuid())
  pageSlug  String
  key       String
  tr        String
  en        String?
  updatedAt DateTime @updatedAt

  @@unique([pageSlug, key])
}
